# r1mc3 (v3) real-time core: the only writer of rt/lowcmd (DESIGN.md §2.1, §3, §11.1 stage 1).
# Installed by deploy/activate.sh from the active release; paths go through /opt/r1mc3/current.
# STOPPING NEVER DAMPS (DESIGN §2.1): manual stop / restart is refused by systemd (RefuseManualStop); the sanctioned
# stop path is `r1 shutdown` (accepted only in DAMP / MONITOR; r1rt then exits by itself) or deploy/bin/r1mc3-svc stop
# (refuses while we own the motors, deploy/bin/r1mc3_motorcheck.py). Neither SIGTERM nor a timeout ever escalates to
# SIGKILL (SendSIGKILL=no, TimeoutStopSec=infinity): r1rt ignores SIGTERM in a publishing mode. If r1rt dies anyway,
# r1guard takes over (DESIGN §4.3 rung 2). Restart=no: a restarted r1rt would re-create the segment under a guard
# that holds the token. Conflicts= r1rt-stand.service (session 6: the stand session's core, BALANCE refused).
[Unit]
Description=r1mc3 real-time core (r1rt, 500 Hz rt/lowcmd writer)
Documentation=file:///opt/r1mc3/current/docs/hardware/DEPLOY.md
After=network-online.target r1mc3-partition.service
Wants=network-online.target r1mc3-partition.service
# session 8 (fix #12): the RT CPU partition once per boot before the core (a failure there never blocks it)
Conflicts=r1rt-stand.service
RefuseManualStop=yes

[Service]
Type=simple
User=unitree
# session 9 (#29's open race): the shared file + the real-time overlay (a bounded receive buffer; install.sh
# --rt-dds-rcvbuf bounded|shared writes it)
Environment=CYCLONEDDS_URI=file:///etc/r1mc3/cyclonedds.xml,file:///etc/r1mc3/cyclonedds_rt.xml
ExecStart=/opt/r1mc3/current/bin/r1rt --config /etc/r1mc3/r1rt.cfg --shm-name /r1mc3.rt --domain 0
ExecStop=-/opt/r1mc3/current/bin/python -I /opt/r1mc3/current/deploy/bin/r1mc3_motorcheck.py --shm-name /r1mc3.rt
KillSignal=SIGTERM
SendSIGKILL=no
TimeoutStopSec=infinity
Restart=no
# RT limits (DESIGN §2.1): the writer thread FIFO 90 on CPU 7, the policy thread FIFO 80 and the DDS receive threads
# FIFO 85 on CPU 6 - the process sets its threads itself; the unit grants the limits and the CPU set.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=90
CPUAffinity=6 7
LimitRTPRIO=95
LimitMEMLOCK=infinity
OOMScoreAdjust=-1000
# No CPUAccounting / CPUQuota / CPUWeight here: on the stock L4T kernel (CONFIG_RT_GROUP_SCHED=y, cgroup v1) a unit
# with its own cpu cgroup gets cpu.rt_runtime_us=0 and SCHED_FIFO fails with EPERM (RESEARCH.md §2.1); without them
# the process stays in the root cpu cgroup. RT_SETUP.md's RT-grant check reads the grant (r1rt logs it, rt_granted).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
